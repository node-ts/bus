{
  "name": "@node-ts/bus-opentelemetry",
  "version": "0.0.0",
  "description": "OpenTelemetry tracing and metrics for @node-ts/bus-core, as bus middleware.",
  "homepage": "https://node-ts.github.io/bus/guide/opentelemetry",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-opentelemetry"
  },
  "bugs": {
    "url": "https://github.com/node-ts/bus/issues"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput",
    "generate:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --out src/test/message-types.generated.ts",
    "check:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --out src/test/message-types.generated.ts --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sns": "^3.1142.0",
    "@aws-sdk/client-sqs": "^3.1142.0",
    "@node-ts/bus-cli": "workspace:^",
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/bus-messages": "workspace:^",
    "@node-ts/bus-rabbitmq": "workspace:^",
    "@node-ts/bus-sqs": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "^1.3.3",
    "@opentelemetry/api": "^1.9.0"
  },
  "keywords": [
    "esb",
    "opentelemetry",
    "tracing",
    "metrics",
    "observability",
    "typescript",
    "bus",
    "messaging",
    "microservices",
    "distributed systems"
  ]
}
