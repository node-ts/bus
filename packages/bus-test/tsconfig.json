{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts", "src/index.mts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.integration.ts", "src/**/test"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    // The fixtures use class-transformer's @Type decorator, which needs the
    // design:type metadata to restore Maps and Sets
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // The suite calls the test runner's describe, it and expect globals
    "types": ["node", "jest"]
  }
}
