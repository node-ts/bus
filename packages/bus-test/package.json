{
  "name": "@node-ts/bus-test",
  "version": "0.0.24",
  "description": "The shared conformance test suite for @node-ts/bus transport adapters.",
  "homepage": "https://github.com/node-ts/bus#readme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-test"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput",
    "generate:message-types": "bus generate-message-types --entry 'src/helpers/**/*.ts' --exclude src/helpers/test-system-message.ts --out src/message-types.generated.ts",
    "check:message-types": "bus generate-message-types --entry 'src/helpers/**/*.ts' --exclude src/helpers/test-system-message.ts --out src/message-types.generated.ts --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/node-ts/bus/issues"
  },
  "dependencies": {
    "@node-ts/bus-messages": "workspace:^",
    "tslib": "^2.8.1",
    "typemoq": "^2.1.0"
  },
  "devDependencies": {
    "@node-ts/bus-cli": "workspace:^",
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/code-standards": "^0.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "^1.0.15",
    "jest": ">=29"
  },
  "peerDependenciesMeta": {
    "jest": {
      "optional": true
    }
  }
}
