{
  "name": "@node-ts/bus-mongodb",
  "description": "A Mongodb persistence adapter for workflow storage in @node-ts/bus-workflow.",
  "version": "1.1.2",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-mongodb"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-ts/bus-messages": "workspace:^",
    "mongodb": "^7.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/bus-test": "workspace:^",
    "@node-ts/code-standards": "^0.0.10",
    "@types/amqplib": "^0.10.8",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "^1.0.0-alpha.0"
  },
  "keywords": [
    "esb",
    "mongodb",
    "typescript",
    "enterprise integration patterns",
    "bus",
    "messaging",
    "microservices",
    "distributed systems",
    "framework",
    "enterprise framework",
    "CQRS",
    "ES",
    "NServiceBus",
    "Mule ESB"
  ],
  "gitHead": "265ea7e16c614971d4b01c3642682d6c93feb52f"
}
