{
  "name": "@node-ts/bus-class-serializer",
  "version": "1.1.2",
  "description": "A JSON serializer for @node-ts/bus based on class-transformer for strong marshalling of messages",
  "homepage": "https://github.com/node-ts/bus#readme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-class-serializer"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@node-ts/bus-core": "workspace:^",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "workspace:^",
    "class-transformer": "^0.5.1"
  },
  "keywords": [
    "serializer",
    "esb",
    "redis",
    "typescript",
    "enterprise integration patterns",
    "bus",
    "messaging",
    "microservices",
    "distributed systems",
    "framework",
    "enterprise framework",
    "CQRS",
    "ES",
    "NServiceBus",
    "Mule ESB"
  ],
  "gitHead": "265ea7e16c614971d4b01c3642682d6c93feb52f"
}
