{
  "name": "@node-ts/bus-cli",
  "version": "0.0.0",
  "description": "Command line tools for @node-ts/bus, including the message type generator.",
  "homepage": "https://github.com/node-ts/bus#readme",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bus": "./bus.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bus.mjs",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-cli"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/node-ts/bus/issues"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/bus-messages": "workspace:^",
    "@types/node": "^24.19.0"
  },
  "keywords": [
    "cli",
    "code generation",
    "serialization",
    "esb",
    "bus",
    "messaging",
    "typescript"
  ]
}
