{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.integration.ts", "src/**/test"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "types": ["node"],
    // A command line with no runtime dependencies, so no tslib
    "importHelpers": false,
    "declaration": false
  }
}
