{
  "name": "@node-ts/bus-azure-service-bus",
  "description": "An Azure Service Bus transport adapter for @node-ts/bus-core.",
  "homepage": "https://node-ts.github.io/bus/transports/azure-service-bus",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-azure-service-bus"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput",
    "generate:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --exclude src/test/service-bus-emulator.ts --out src/test/message-types.generated.ts",
    "check:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --exclude src/test/service-bus-emulator.ts --out src/test/message-types.generated.ts --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@azure/service-bus": "^7.10.0",
    "@node-ts/bus-messages": "workspace:^",
    "serialize-error": "8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@node-ts/bus-cli": "workspace:^",
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/bus-test": "workspace:^",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "^1.3.3"
  },
  "keywords": [
    "esb",
    "azure",
    "azure service bus",
    "service bus",
    "typescript",
    "enterprise integration patterns",
    "bus",
    "messaging",
    "microservices",
    "distributed systems"
  ]
}
