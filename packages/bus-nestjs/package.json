{
  "name": "@node-ts/bus-nestjs",
  "version": "0.0.0",
  "description": "A NestJS module for @node-ts/bus-core: handlers and workflows as providers, and the bus run by Nest's lifecycle.",
  "homepage": "https://node-ts.github.io/bus/guide/nestjs",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-nestjs"
  },
  "bugs": {
    "url": "https://github.com/node-ts/bus/issues"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput",
    "generate:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --out src/test/message-types.generated.ts",
    "check:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --out src/test/message-types.generated.ts --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-ts/bus-messages": "workspace:^",
    "serialize-error": "8",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@node-ts/bus-cli": "workspace:^",
    "@node-ts/bus-core": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@node-ts/bus-core": "^1.3.3"
  },
  "keywords": [
    "esb",
    "nestjs",
    "nest",
    "dependency injection",
    "typescript",
    "bus",
    "messaging",
    "microservices",
    "distributed systems"
  ]
}
