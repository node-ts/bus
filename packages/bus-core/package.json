{
  "name": "@node-ts/bus-core",
  "version": "1.3.3",
  "description": "A service bus for message-based, distributed node applications",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-core"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-ts/bus-messages": "workspace:^",
    "debug": "^4.4.3",
    "serialize-error": "8",
    "supports-color": "^11.0.0",
    "throat": "^6.0.2",
    "tslib": "^2.8.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@node-ts/code-standards": "^0.0.10",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.19.0",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "esb",
    "bus",
    "messaging",
    "microservices",
    "distributed systems",
    "CQRS",
    "ES",
    "NServiceBus",
    "Mule ESB",
    "typescript"
  ],
  "gitHead": "265ea7e16c614971d4b01c3642682d6c93feb52f"
}
