{
  "name": "@node-ts/bus-sqs-lambda",
  "description": "A retrieval mechanism that receives messages from SQS-subscribed lambda.",
  "version": "1.0.1",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-sqs-lambda"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput",
    "generate:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --exclude src/test/to-lambda-record.ts --out src/test/message-types.generated.ts",
    "check:message-types": "bus generate-message-types --entry 'src/test/**/*.ts' --exclude src/test/to-lambda-record.ts --out src/test/message-types.generated.ts --check"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@node-ts/bus-messages": "workspace:^",
    "@node-ts/bus-sqs": "workspace:^",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-sns": "^3.1142.0",
    "@aws-sdk/client-sqs": "^3.1142.0",
    "@node-ts/bus-cli": "workspace:^",
    "@node-ts/bus-core": "workspace:^",
    "@node-ts/bus-test": "workspace:^",
    "@node-ts/code-standards": "^0.0.10",
    "@types/aws-lambda": "^8.10.164",
    "typemoq": "^2.1.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@node-ts/bus-core": "^1.3.4"
  },
  "keywords": [
    "esb",
    "SQS",
    "typescript",
    "enterprise integration patterns",
    "bus",
    "messaging",
    "microservices",
    "distributed systems",
    "framework",
    "enterprise framework",
    "CQRS",
    "ES",
    "NServiceBus",
    "Mule ESB",
    "Serverless",
    "Lambda"
  ]
}
