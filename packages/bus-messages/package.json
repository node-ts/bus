{
  "name": "@node-ts/bus-messages",
  "description": "A core set of message definitions for distributed applications.",
  "version": "1.1.2",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-ts/bus.git",
    "directory": "packages/bus-messages"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "build:watch": "pnpm run build --incremental --watch --preserveWatchOutput"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@node-ts/code-standards": "^0.0.10",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "esb",
    "bus",
    "messaging",
    "microservices",
    "distributed systems",
    "CQRS",
    "ES",
    "NServiceBus",
    "Mule ESB",
    "typescript"
  ]
}
