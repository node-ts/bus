{
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "declaration": true,
    "strictPropertyInitialization": false,
    // Targets from ES2022 up default this to true, which turns declared-only
    // fields into own properties set to undefined. Keep the assignment
    // semantics the packages were built with.
    "useDefineForClassFields": false,

    // Handled in linting, useful for testing
    "allowUnreachableCode": true,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "importHelpers": true
  }
}
