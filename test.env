AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_ACCESS_KEY_ID=dummy_key_id
AWS_SECRET_ACCESS_KEY=dummy_access_key

# Lets jest load ES modules, which it only does with vm modules on:
# - NestJS 12 is ESM only, and bus-nestjs' tests require() it.
# - The mongodb driver 7.6+ loads `os` with a dynamic import() during the
#   handshake. Without it the server rejects the connection with "Missing
#   required sub-document 'driver'" (NODE-7832,
#   https://github.com/mongodb/node-mongodb-native/pull/5059).
NODE_OPTIONS="--experimental-vm-modules --disable-warning=ExperimentalWarning"

# Integration test endpoints. Each has a default in its *.integration.ts that
# matches docker-compose.yml, so these are only needed to point elsewhere.
# LOCALSTACK_ENDPOINT=http://localhost:4566
# RABBITMQ_URL=amqp://guest:guest@0.0.0.0
# RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672
# POSTGRES_URL=postgres://postgres:password@localhost:6432/postgres
# MONGODB_URL=mongodb://localhost:27017/workflows?directConnection=true
