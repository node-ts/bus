AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_ACCESS_KEY_ID=dummy_key_id
AWS_SECRET_ACCESS_KEY=dummy_access_key

# Lets jest require() ES modules: Node 24's require(esm) only works inside jest
# with vm modules on. Needed for ESM-only dev deps such as @faker-js/faker 10,
# and for mongodb 7.6+, whose handshake runs a dynamic import('os') (NODE-7832).
NODE_OPTIONS="--experimental-vm-modules --disable-warning=ExperimentalWarning"

# Integration test endpoints. Each has a default in its *.integration.ts that
# matches docker-compose.yml, so these are only needed to point elsewhere.
# LOCALSTACK_ENDPOINT=http://localhost:4566
# RABBITMQ_URL=amqp://guest:guest@0.0.0.0
# POSTGRES_URL=postgres://postgres:password@localhost:6432/postgres
# MONGODB_URL=mongodb://localhost:27017/workflows
