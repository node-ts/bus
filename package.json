{
  "name": "@node-ts/bus",
  "version": "0.0.3",
  "main": "index.js",
  "description": "A service bus for message-based, distributed node applications",
  "repository": "github:node-ts/bus.git",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm run --recursive build",
    "build:watch": "pnpm run --recursive build:watch",
    "check:packages": "node tools/check-packages.mjs",
    "check:message-types": "pnpm --recursive --if-present run check:message-types",
    "docs:dev": "pnpm --filter bus-docs run docs:dev",
    "docs:build": "pnpm --filter bus-docs run docs:build",
    "docs:preview": "pnpm --filter bus-docs run docs:preview",
    "docs:typecheck": "pnpm --filter bus-docs run docs:typecheck",
    "docs:check-redirects": "pnpm --filter bus-docs run docs:check-redirects",
    "clean": "pnpm run --recursive clean && rm -r node_modules",
    "format": "prettier --ignore-path .gitignore --write --config .prettierrc.js . \"!**/*.(yml|yaml|mdx)\"",
    "format:check": "prettier --ignore-path .gitignore --check --config .prettierrc.js . \"!**/*.(yml|yaml|mdx)\"",
    "lint": "eslint .",
    "format:precommit": "lint-staged",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "test": "dotenv -e test.env -- jest --collect-coverage",
    "test:unit": "dotenv -e test.env -- jest \"(src\\/.+\\.|/)spec\\.ts$\"",
    "test:integration": "dotenv -e test.env -- jest --runInBand \"(src\\/.+\\.|/)integration\\.ts$\"",
    "test:watch": "dotenv -e test.env -- jest --watch"
  },
  "keywords": [
    "typescript",
    "enterprise service bus",
    "distributed system",
    "message bus",
    "message queue",
    "node"
  ],
  "engines": {
    "pnpm": "^12.4.1",
    "node": ">=24.11.1"
  },
  "packageManager": "pnpm@12.4.1",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "publint": "^0.3.24",
    "supports-color": "^11.0.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.(ts|mts|js|mjs)": [
      "prettier --ignore-path .gitignore --write --config .prettierrc.js",
      "eslint --no-warn-ignored"
    ],
    "*.(tsx|md|css|html|json)": "prettier --ignore-path .gitignore --write --config .prettierrc.js"
  }
}
